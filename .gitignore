# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# pnpm settings live in package.json. A project .npmrc here would risk
# committing the machine's CodeArtifact auth token.
.npmrc

# editors
.idea
.vscode/*
!.vscode/extensions.json

# terrain contact sheets from `pnpm terrain -- --preview`
.terrain-preview

# agent git worktrees, full nested checkouts of this repo
# (also ignored by eslint and prettier)
.claude/worktrees/

# Screen recordings and video scratch files.
#
# An 18MB screen recording was committed to the repo root once, in a public
# repository, and nothing caught it: the 3MB asset cap in verify-export.mjs only
# walks out/, and a file sitting at the root never reaches the export. Video
# that is genuinely part of the site goes in public/, which is exempt below.
*.mov
*.mp4
*.webm
!public/**/*.mov
!public/**/*.mp4
!public/**/*.webm
